# Admin panel talks to Express via a thin NextAuth/cookie proxy.
# Copy to .env and fill in values.

NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=
AUTH_SECRET=
JWT_SECRET=

# Express API origin used by the server-side proxy
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
